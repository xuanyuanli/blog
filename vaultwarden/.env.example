# 对外访问地址（须与 Nginx 域名一致，含 https）
DOMAIN=https://vault.xuanyuanli.cn

# 首次部署保持 true，注册完自己的账号后改为 false 再 bops vault
SIGNUPS_ALLOWED=true

# 管理后台：推荐 Argon2 PHC。docker compose 的 .env 里每个 $ 须写成 $$
# 生成示例（容器内）：docker exec -it vaultwarden /vaultwarden hash
# 访问 https://vault.xuanyuanli.cn/admin 时填「哈希前的明文口令」
ADMIN_TOKEN=

# WebSocket 默认开启；显式写出便于排查
ENABLE_WEBSOCKET=true
